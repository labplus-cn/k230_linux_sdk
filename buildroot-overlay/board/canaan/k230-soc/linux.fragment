CONFIG_BT=m
CONFIG_USB_USBNET=y
# Keep the complete gadget path built in so boot-time module ordering cannot
# make the composite device disappear.
CONFIG_CONFIGFS_FS=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_F_ACM=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_F_MASS_STORAGE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
# USB Gadget CDC ACM virtual serial port (ttyGS0)
CONFIG_USB_CONFIGFS_ACM=y
# USB Gadget RNDIS virtual network card (usb0)
CONFIG_USB_CONFIGFS_RNDIS=y
