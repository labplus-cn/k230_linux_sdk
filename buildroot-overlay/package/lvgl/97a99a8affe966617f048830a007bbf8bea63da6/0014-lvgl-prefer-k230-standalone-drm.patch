         free(data);
+        k230_release_owned_display();
         return NULL;
     }
 
@@ -175,6 +202,8 @@
     lv_display_t * disp = lv_display_create(disp_w, disp_h);
     if(disp == NULL) {
         LV_LOG_ERROR("lv_display_create failed");
+        free(data);
+        k230_release_owned_display();
         return NULL;
     }
 
@@ -203,9 +232,9 @@
     lv_display_set_flush_wait_cb(disp, drm_k230_flush_wait);
     lv_display_set_user_data(disp, data);
 
