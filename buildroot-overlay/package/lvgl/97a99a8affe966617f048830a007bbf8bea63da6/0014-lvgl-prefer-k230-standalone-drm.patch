+        k230_release_owned_display();
         return NULL;
     }
     data->bufs[0] = display_allocate_buffer(plane, disp_w, disp_h);
@@ -153,6 +179,7 @@
     if(data->bufs[0] == NULL || data->bufs[1] == NULL) {
