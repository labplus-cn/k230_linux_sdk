diff --git a/src/lib/display_backends/drm_k230_v4l2.c b/src/lib/display_backends/drm_k230_v4l2.c
--- a/src/lib/display_backends/drm_k230_v4l2.c
+++ b/src/lib/display_backends/drm_k230_v4l2.c
@@ -59,9 +59,26 @@
 static char * backend_name = "DRM_V4L2_K230";
 
 
-static  struct display * k230_display = NULL;
+static struct display * k230_display = NULL;
+static bool k230_display_owned = false;
 static char k230_dispaly_v4l2_drm_run_flag = 0;
-static unsigned int flush_data_fram_count=0;
+static unsigned int flush_data_fram_count = 0;
+
+static bool k230_use_v4l2_thread(void)
+{
+    return k230_display != NULL && k230_dispaly_v4l2_drm_run_flag;
+}
+
+static void k230_release_owned_display(void)
+{
+    if(!k230_display_owned || k230_display == NULL) {
+        return;
+    }
+
+    display_exit(k230_display);
+    k230_display = NULL;
+    k230_display_owned = false;
+}
 
 /**********************
  *      MACROS
@@ -107,8 +124,15 @@
