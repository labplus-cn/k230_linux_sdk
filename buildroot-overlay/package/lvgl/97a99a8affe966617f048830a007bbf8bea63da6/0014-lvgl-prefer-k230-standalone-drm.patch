-        return NULL;
+        k230_display = display_init(0);
+        if(k230_display == NULL) {
+            LV_LOG_ERROR("display_init(0) failed for standalone K230 DRM backend");
+            return NULL;
+        }
+
+        k230_display_owned = true;
+        LV_LOG_INFO("Using standalone K230 DRM display: %ux%u",
+                    k230_display->width, k230_display->height);
     }
 
     /* Determine LVGL display and buffer dimensions based on rotation.
@@ -137,6 +161,7 @@
