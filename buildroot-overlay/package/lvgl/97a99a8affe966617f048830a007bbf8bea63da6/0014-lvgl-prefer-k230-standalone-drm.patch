+                k230_display->drm_rotation, fourcc, k230_display_owned ? 1 : 0);
 
     return disp;
 }
@@ -225,7 +254,6 @@
 static void drm_k230_flush(lv_display_t * disp, const lv_area_t * area, uint8_t * px_map)
 {
     LV_UNUSED(area);
-    (void)k230_dispaly_v4l2_drm_run_flag;
     if(!lv_display_flush_is_last(disp)) return;
 
     drm_k230_data_t * data = lv_display_get_user_data(disp);
@@ -250,9 +278,15 @@
     /* Flush CPU dcache so DRM DMA reads the rendered pixels */
     thead_csi_dcache_clean_invalid_range(buf->map, buf->size);
 
