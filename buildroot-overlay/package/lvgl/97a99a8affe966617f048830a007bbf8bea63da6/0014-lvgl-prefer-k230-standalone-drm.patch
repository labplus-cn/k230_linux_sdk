+        flush_data_fram_count = k230_display->frame_count;
+    }
+    else if(display_commit_buffer_noblock(buf, 0, 0) < 0) {
+        LV_LOG_ERROR("display_commit_buffer_noblock failed for fb_id=%u",
+                     buf->id);
+    }
 
     lv_display_flush_ready(disp);
 }
@@ -267,7 +301,7 @@
 static void drm_k230_flush_wait(lv_display_t * disp)
 {
     LV_UNUSED(disp);
-    if(k230_display == NULL) return;
+    if(k230_display == NULL || !k230_use_v4l2_thread()) return;
 
     while(k230_display->lvgl_disp_buffer && (k230_display->frame_count <= flush_data_fram_count)){
         usleep(15000);
@@ -294,9 +328,9 @@
 
     k230_dispaly_v4l2_drm_run_flag = v4l2_drm_run_flag;
 
